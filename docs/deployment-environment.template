# RideFlow deployment environment template
# Copy these names into your host's secret manager or local .env file.
# Never commit populated values.

NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://your-rideflow-domain.example
DATABASE_URL=mysql://rideflow_app:replace-me@database-host:3306/rideflow
JWT_SECRET=generate-a-long-random-value

# Provider-neutral OIDC authentication
OAUTH_ISSUER_URL=https://your-identity-provider.example
OAUTH_TOKEN_URL=https://your-identity-provider.example/oauth/token
OAUTH_USERINFO_URL=https://your-identity-provider.example/oauth/userinfo
OAUTH_CLIENT_ID=replace-me
OAUTH_CLIENT_SECRET=replace-me
VITE_OAUTH_AUTHORIZE_URL=https://your-identity-provider.example/oauth/authorize
VITE_OAUTH_CLIENT_ID=replace-me
VITE_OAUTH_SCOPE=openid profile email

# Private S3-compatible object storage
S3_BUCKET=rideflow-private
S3_REGION=auto
S3_ENDPOINT=https://your-s3-compatible-endpoint.example
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL_SECONDS=900
S3_SERVER_SIDE_ENCRYPTION=

# Signup and operations notifications
RIDEFLOW_ADMIN_EMAIL=njengastephen112@gmail.com
NOTIFICATION_PROVIDER_URL=https://your-notification-webhook.example/rideflow
NOTIFICATION_PROVIDER_TOKEN=replace-me

# Stripe Connect marketplace payments
PAYMENTS_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me

# Safaricom M-Pesa Daraja
PAYMENTS_DARAJA_ENABLED=false
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=replace-me
DARAJA_CONSUMER_SECRET=replace-me
DARAJA_SHORTCODE=replace-me
DARAJA_PASSKEY=replace-me
DARAJA_INITIATOR_NAME=replace-me
DARAJA_SECURITY_CREDENTIAL=replace-me
DARAJA_CALLBACK_BASE_URL=https://your-rideflow-domain.example/api/webhooks/daraja
